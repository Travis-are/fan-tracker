# ============================================
# SUPABASE
# ============================================
# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER-SIDE ONLY. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# GEMINI AI (Google AI Studio)
# ============================================
# From https://aistudio.google.com/app/apikey
# SERVER-SIDE ONLY. Never reference this in a "use client" file.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# REDDIT API (public read-only data)
# ============================================
# From https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=celebrity-fan-demand-intel/1.0

# ============================================
# YOUTUBE API (optional, add later)
# ============================================
# From Google Cloud Console -> Enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# ============================================
# APP CONFIG
# ============================================
# "true" forces demo data mode regardless of API key presence.
# Leave "false" (or unset) to use live data when keys above are present,
# and auto-fallback to demo data when they are not.
DEMO_MODE=false

# Secret used to authorize Vercel Cron -> /api/cron requests
CRON_SECRET=generate-a-long-random-string

# Public base URL of the deployed app (used in server-side fetches)
NEXT_PUBLIC_APP_URL=http://localhost:3000
